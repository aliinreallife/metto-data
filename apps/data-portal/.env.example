# Server-side only. The existing Vercel project already supplies DATABASE_URL.
DATABASE_URL=

# Canonical public origin. Other hosts remain read-only.
DATA_PORTAL_ORIGIN=https://novus-peach-seven.vercel.app

# A random server-only key used to hash IPs for quotas. Provisioned during setup.
DATA_PORTAL_QUOTA_SECRET=

# Optional alternatives: private Blob storage if Postgres is unavailable;
# a dedicated GitHub token only if immediate issue publication is desired.
# Production uses GitHub Actions' temporary job credential instead.
# BLOB_READ_WRITE_TOKEN=
# GITHUB_TOKEN=
