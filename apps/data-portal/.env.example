# Server-side only. Add these in Vercel project settings, never in the browser.
# Connect a PRIVATE Vercel Blob store to this project; Vercel supplies this token.
BLOB_READ_WRITE_TOKEN=

# Fine-grained GitHub token restricted to aliinreallife/metto-data: Issues read/write.
GITHUB_TOKEN=

# The public origin visitors actually use, without a path or trailing slash.
# Use a canonical domain and redirect other aliases to it.
DATA_PORTAL_ORIGIN=https://data.metto.ir

# Optional daily outbox maintenance. Generate a long random value privately and
# use the same value in the repository Actions secret with this exact name.
DATA_PORTAL_AUTOMATION_SECRET=
