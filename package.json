{
  "name": "metto-data",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical transit data layer for Metto. Upstream datasets are source material only; Metto consumes generated data/cities/*.",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:tehran": "tsx scripts/build.ts --city tehran",
    "validate": "tsx scripts/validate.ts",
    "check-release": "tsx scripts/check-release.ts",
    "contributions:validate": "tsx scripts/contributions-validate.ts",
    "contributions:new": "tsx scripts/new-contribution.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "provenance:check": "tsx scripts/check-provenance.ts",
    "generated:check": "tsx scripts/check-generated.ts",
    "quality:report": "tsx scripts/quality-report.ts",
    "workflows:check": "tsx scripts/check-workflows.ts",
    "dev": "pnpm --filter @metto/data-portal dev",
    "portal:build": "pnpm --filter @metto/data-portal build",
    "portal:typecheck": "pnpm --filter @metto/data-portal typecheck",
    "portal:start": "pnpm --filter @metto/data-portal start",
    "portal:test:ui": "pnpm --filter @metto/data-portal test:ui",
    "map-reference:build": "tsx scripts/build-construction-map.ts",
    "map-reference:check": "tsx scripts/build-construction-map.ts --check",
    "source:osm:candidates": "node scripts/osm-candidate-intake.mjs",
    "source:osm:name-review": "node scripts/osm-name-review.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "^22.20.2",
    "jose": "6.2.13",
    "tsx": "^4.19.0",
    "typescript": "5.7.3",
    "vitest": "^5.0.0"
  }
}
