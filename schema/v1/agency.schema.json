{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data.metto.ir/schemas/v1/agency.json",
  "title": "Agency (metto-data schema v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "cityId", "names"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+:agency:.+$" },
    "cityId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "names": {
      "type": "object",
      "required": ["fa", "en"],
      "properties": { "fa": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    }
  }
}
